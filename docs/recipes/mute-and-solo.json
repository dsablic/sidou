          "button": "SEQ",
          "op": "press"
        },
        {
          "ms": 900,
          "op": "wait"
        },
        {
          "button": "SEQ",
          "op": "press"
        },
        {
          "ms": 900,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "Open the *song*"
    },
    {
