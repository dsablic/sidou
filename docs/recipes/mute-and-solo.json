      "inputs": [
        {
          "button": "GLO",
          "note": "G#3",
          "op": "hold_key"
        },
        {
          "ms": 3000,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "*Solo* the lead"
    },
    {
      "caption": "Again to unsolo.",
      "control": "Hold GLO and press note key 4 again",
      "expect": [
        {
          "kind": "text_absent",
          "value": "SOL"
        },
        {
          "assert": "louder",
          "kind": "audio"
        }
      ],
      "focus": {
        "screen": {
          "col": 0,
