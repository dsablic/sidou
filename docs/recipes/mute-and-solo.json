        },
        {
          "ms": 3000,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "*Mute* voice 2"
    },
    {
      "caption": "The same keys again, and the bass is back in.",
      "control": "Hold GLO and press note key 2 again",
      "expect": [
        {
          "assert": "louder",
          "kind": "audio"
        }
      ],
      "focus": {
        "screen": {
          "col": 0,
          "cols": 30,
          "row": 0,
          "rows": 3
        }
