        {
          "assert": "quieter",
          "kind": "audio"
        }
      ],
      "focus": {
        "screen": {
          "col": 0,
          "cols": 30,
          "row": 0,
          "rows": 3
        }
      },
      "harness": {
        "clip_ms": null,
