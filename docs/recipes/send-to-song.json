      "inputs": [
        {
          "button": "SEQ",
          "op": "press"
        },
        {
          "ms": 500,
          "op": "wait"
        },
        {
          "button": "SEQ",
          "op": "press"
        },
        {
          "ms": 500,
          "op": "wait"
        },
        {
          "button": "SEQ",
          "op": "press"
        },
        {
          "ms": 500,
          "op": "wait"
        },
        {
          "button": "SEQ",
          "op": "press"
        },
        {
          "ms": 800,
          "op": "wait"
        },
        {
          "detents": 2,
          "encoder": "SELECT",
          "op": "turn"
        },
        {
          "ms": 1600,
          "op": "wait"
        },
        {
          "detents": 2,
          "encoder": "SELECT",
          "op": "turn"
        },
        {
          "ms": 1600,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "On *INSTR*"
    },
    {
      "caption": "ENV on INSTR takes it into LAB again. Sent and not edited since, it comes back exactly: PULLED I06.",
      "control": "press ENV, then wait 1.3 s",
      "expect": [
        {
          "kind": "view",
          "value": "lab"
        },
        {
          "kind": "text",
          "value": "PULLED I06"
