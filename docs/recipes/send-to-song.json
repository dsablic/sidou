      "inputs": [
        {
          "button": "REC",
          "op": "press"
        },
        {
          "ms": 1300,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "*REC* sends it"
    },
    {
      "caption": "For six seconds the hint line says what GoatTracker could only come close to, or what stayed behind.",
      "control": "wait 3.0 s",
      "expect": [
        {
          "kind": "text",
          "value": "APPROX"
        },
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "THE HINT LINE",
        "control": "screen",
        "screen": {
          "col": 0,
          "cols": 30,
          "row": 26,
          "rows": 4
        }
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "hint",
      "inputs": [
        {
          "ms": 3000,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "What it *approximates*"
    },
    {
      "caption": "SEQ round to INSTR: it opens on 06, SAW LEAD, a song instrument now. The foot says what each program plays.",
      "control": "press SEQ, then wait 0.5 s, then press SEQ, then wait 0.5 s, then press SEQ, then wait 0.5 s, then press SEQ, then wait 0.8 s, then turn SELECT clockwise by 2 detents, then wait 1.6 s, then turn SELECT clockwise by 2 detents, then wait 1.6 s",
      "expect": [
        {
          "kind": "view",
          "value": "song_pages_instr"
        },
        {
          "kind": "text",
          "value": "SAW LEAD"
        },
        {
          "kind": "text_large",
          "value": "LP"
        },
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "SEQ TO INSTR, SELECT",
        "control": "SELECT",
        "screen": {
          "col": 0,
          "cols": 30,
          "row": 0,
          "rows": 30
        }
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
