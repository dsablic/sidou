    },
    {
      "caption": "K4 lets the notes ring on.",
      "control": "turn K4 slowly clockwise by 4 detents over 0.8 s, then wait for the song's next pattern, then play 6 notes at 125 BPM",
      "expect": [
        {
          "assert": "sounding",
