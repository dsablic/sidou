{
  "goal": "Shape a sound in LAB while the song plays, send it into the song as a GoatTracker 2 instrument, find it on INSTR, pull it back and replace it.",
  "id": "send-to-song",
  "prerequisites": {
    "start": "live",
    "text": "On LIVE after the boot, SIDOU LOOP the song loaded: its lowest free instrument is 06."
  },
  "related": [
    "shape-in-lab",
    "lift-a-sound",
    "whats-new"
  ],
  "schema": "sidou-recipe/1",
  "skills": [
    "LAB",
    "REC sends a LAB sound to the song",
    "the hint line",
    "INSTR",
    "ENV on INSTR pulls the instrument into LAB",
    "EDIT + REC replaces INSTR's instrument"
  ],
  "steps": [
    {
      "caption": "ENV on LIVE opens LAB at its envelope page, with SAW LEAD. Listen first.",
      "control": "press ENV, then wait 0.8 s, then play 4 notes at 120 BPM",
      "expect": [
        {
          "kind": "view",
          "value": "lab"
        },
        {
          "kind": "text",
          "value": "ENVELOPE"
        },
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "PRESS ENV",
        "control": "ENV"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "open",
      "inputs": [
        {
          "button": "ENV",
          "op": "press"
        },
        {
          "ms": 800,
          "op": "wait"
        },
        {
          "bpm": 120,
          "events": [
            {
              "notes": [
                "A3"
              ],
              "sixteenths": 2
            },
            {
              "notes": [
                "C4"
              ],
              "sixteenths": 2
            },
            {
              "notes": [
                "E4"
              ],
              "sixteenths": 2
            },
            {
              "notes": [
                "A4"
              ],
              "sixteenths": 4
            }
          ],
          "op": "play"
        }
      ],
      "needs": [],
      "title": "*ENV* opens LAB"
    },
    {
      "caption": "PLAY in LAB plays SIDOU LOOP; the keys play your sound over it.",
      "control": "press PLAY, then wait 1.0 s, then wait for the song's next pattern, then play 6 notes at 125 BPM",
      "expect": [
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "PLAY, THEN THE KEYS",
        "control": "PLAY"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "play",
      "inputs": [
        {
          "button": "PLAY",
          "op": "press"
        },
        {
          "ms": 1000,
          "op": "wait"
        },
        {
          "op": "sync"
        },
        {
          "bpm": 125,
          "events": [
            {
              "notes": [
                "A4"
              ],
              "sixteenths": 2
            },
            {
              "notes": [
                "C5"
              ],
              "sixteenths": 2
            },
            {
              "notes": [
                "E5"
              ],
              "sixteenths": 4
            },
            {
              "notes": [
                "D5"
              ],
              "sixteenths": 2
            },
            {
              "notes": [
                "C5"
              ],
              "sixteenths": 2
            },
            {
              "notes": [
                "A4"
              ],
              "sixteenths": 4
            }
          ],
          "op": "play"
        }
      ],
      "needs": [],
      "title": "The song plays *on*"
    },
    {
      "caption": "K2 shortens the decay. SELECT to FILTER, and K1 closes the filter a little.",
      "control": "turn K2 slowly counter-clockwise by 3 detents over 0.6 s, then turn SELECT clockwise by 1 detent, then wait 0.5 s, then turn K1 slowly counter-clockwise by 20 detents over 0.9 s, then play 6 notes at 125 BPM",
      "expect": [
        {
          "kind": "text",
          "value": "FILTER"
        },
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "TURN K2, SELECT, TURN K1",
        "control": "K1"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "shape",
      "inputs": [
        {
          "detents": -3,
          "encoder": "K2",
          "ms": 600,
          "op": "sweep"
        },
        {
          "detents": 1,
          "encoder": "SELECT",
          "op": "turn"
        },
        {
          "ms": 500,
          "op": "wait"
        },
        {
          "detents": -20,
          "encoder": "K1",
          "ms": 900,
          "op": "sweep"
        },
        {
          "bpm": 125,
          "events": [
            {
              "notes": [
                "A4"
              ],
              "sixteenths": 2
            },
            {
              "notes": [
                "C5"
              ],
              "sixteenths": 2
            },
            {
              "notes": [
                "E5"
              ],
              "sixteenths": 4
            },
            {
              "notes": [
                "D5"
              ],
              "sixteenths": 2
            },
            {
              "notes": [
                "C5"
              ],
              "sixteenths": 2
            },
            {
              "notes": [
                "A4"
              ],
              "sixteenths": 4
            }
          ],
          "op": "play"
        }
      ],
      "needs": [],
      "title": "*Shape* it"
    },
    {
      "caption": "REC: the sound goes into the song's lowest free instrument as a plain GoatTracker 2 one, a byte at a time, so the song plays on.",
      "control": "press REC, then wait 1.3 s",
      "expect": [
        {
          "kind": "text",
          "value": "SENT AS I06"
        },
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "PRESS REC",
        "control": "REC"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
