{
  "goal": "Open and close the filter, add resonance and change the sound while a chord holds.",
  "id": "shape-a-sound",
  "prerequisites": {
    "start": "live",
    "text": "On LIVE after the boot, with the first preset (SAW LEAD) playing."
  },
  "related": [
    "first-sound",
    "mute-and-solo"
  ],
  "schema": "sidou-recipe/1",
  "skills": [
    "K1 cutoff",
    "K2 resonance",
    "PRESETS",
    "holding a note while turning"
  ],
  "steps": [
    {
      "caption": "Hold three keys and keep holding them while you turn the knobs.",
      "control": "Hold the note keys A, C and E down",
      "expect": [
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "HOLD A CHORD"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "hold-a-note",
      "inputs": [
        {
          "note": "A3",
          "op": "down"
        },
        {
          "note": "C4",
          "op": "down"
        },
        {
          "note": "E4",
          "op": "down"
        },
        {
          "ms": 1500,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "Hold a *chord*"
    },
    {
      "caption": "Turn K1 counter-clockwise, slowly: the sound goes dark and warm.",
      "control": "Turn K1 counter-clockwise about a third of a turn",
      "expect": [
        {
          "assert": "darker",
          "kind": "audio"
        },
        {
          "kind": "screen_changes"
        },
        {
          "kind": "param",
          "max": 1100,
          "min": 0,
          "name": "cutoff"
        }
      ],
      "focus": {
        "screen": {
          "col": 0,
          "cols": 30,
          "row": 15,
          "rows": 7
        }
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "close-the-filter",
      "inputs": [
        {
          "detents": -60,
          "encoder": "K1",
          "ms": 3000,
          "op": "sweep"
        },
        {
          "ms": 1500,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "*K1* closes the filter"
    },
    {
      "caption": "Turn it back up and past: bright again, all the way.",
      "control": "Turn K1 clockwise about a full turn",
      "expect": [
        {
          "assert": "brighter",
          "kind": "audio"
        },
        {
          "kind": "param",
          "max": 2047,
          "min": 1100,
          "name": "cutoff"
        }
      ],
      "focus": {
        "screen": {
          "col": 0,
          "cols": 30,
          "row": 15,
          "rows": 7
        }
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "open-the-filter",
      "inputs": [
        {
          "detents": 100,
          "encoder": "K1",
          "ms": 3000,
          "op": "sweep"
        },
        {
          "ms": 1200,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "And *opens* it"
    },
    {
      "caption": "K2 makes the filter ring at its cutoff. Sweep K1 again to hear it sing.",
      "control": "Turn K2 clockwise about a quarter turn, then K1 down and up",
      "expect": [
        {
          "kind": "screen_changes"
        },
        {
          "kind": "param",
          "max": 15,
          "min": 10,
          "name": "resonance"
        }
      ],
      "focus": {
        "callout": "TURN K2, THEN K1",
        "screen": {
          "col": 0,
          "cols": 30,
          "row": 15,
          "rows": 7
        }
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "add-resonance",
      "inputs": [
        {
          "detents": 10,
          "encoder": "K2",
          "ms": 1200,
          "op": "sweep"
        },
        {
          "detents": -40,
          "encoder": "K1",
          "ms": 2000,
          "op": "sweep"
        },
        {
          "detents": 40,
          "encoder": "K1",
          "ms": 2000,
          "op": "sweep"
        }
      ],
      "needs": [],
      "title": "*K2*: resonance"
    },
    {
      "caption": "The big knob picks the next preset, PWM BASS. Your edits to SAW LEAD are kept.",
      "control": "Turn PRESETS one click clockwise",
      "expect": [
        {
          "kind": "text",
          "value": "PWM BASS"
        },
        {
          "kind": "param",
          "max": 1,
          "min": 1,
          "name": "preset"
        },
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "screen": {
          "col": 0,
          "cols": 30,
          "row": 0,
          "rows": 2
        }
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "next-sound",
      "inputs": [
        {
          "detents": 1,
          "encoder": "PRESETS",
          "op": "turn"
        },
        {
          "ms": 2500,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "*PRESETS*: another sound"
    },
    {
      "caption": "Let go of the keys: the release rings out.",
      "control": "Let go of the note keys",
      "expect": [
        {
          "assert": "silent",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "LET GO"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "let-go",
      "inputs": [
        {
          "note": "A3",
          "op": "up"
        },
        {
          "note": "C4",
          "op": "up"
        },
        {
          "note": "E4",
          "op": "up"
        },
        {
          "ms": 1500,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "Let *go*"
    }
  ],
  "title": "Shape a sound with K1 to K4"
}
