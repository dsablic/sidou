{
  "goal": "Take a voice's sound out of a .sid tune into LAB: REC, the voice's key, then play it, shape it and keep it as a USER sound.",
  "id": "lift-a-sound",
  "prerequisites": {
    "start": "live",
    "text": "On LIVE after the boot; THE CONSULTANT, a GoatTracker tune by Cadaver, in the store.",
    "tunes": [
      "consultant"
    ]
  },
  "related": [
    "play-a-sid",
    "shape-in-lab",
    "send-to-song",
    "whats-new"
  ],
  "schema": "sidou-recipe/1",
  "skills": [
    "SIDS",
    "REC asks which voice to lift",
    "a note key answers",
    "the lifted sound in LAB",
    "SAVE keeps a USER sound",
    "HOME back to the tune"
  ],
  "steps": [
    {
      "caption": "HOME, SIDS, SAVE for the list: ALGORITHM plays THE CONSULTANT.",
      "control": "press HOME, then wait 0.5 s, then turn SELECT until SIDS is selected, then press SAVE, then wait 1.2 s, then turn ALGORITHM clockwise by 1 detent, then wait 2.6 s",
      "expect": [
        {
          "kind": "view",
          "value": "sid_view_playing"
        },
        {
          "kind": "text",
          "value": "PLAYING"
        },
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "MENU > SIDS, ALGORITHM",
        "control": "ALGORITHM"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "play",
      "inputs": [
        {
          "button": "HOME",
          "op": "press"
        },
        {
          "ms": 500,
          "op": "wait"
        },
        {
          "op": "select_item",
          "text": "SIDS"
        },
        {
          "button": "SAVE",
          "op": "press"
        },
        {
          "ms": 1200,
          "op": "wait"
        },
        {
          "detents": 1,
          "encoder": "ALGORITHM",
          "op": "turn"
        },
        {
          "ms": 2600,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "A *.sid* tune"
    },
    {
      "caption": "REC: which voice? Keys 1 to 3 light up as the answers, and the bars show which voice plays what.",
      "control": "press REC, then wait 1.5 s",
      "expect": [
        {
          "kind": "text_large",
          "value": "LIFT WHICH"
        },
        {
          "kind": "text_large",
          "value": "VOICE? 1 2 3"
        },
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "PRESS REC",
        "control": "REC"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "ask",
      "inputs": [
        {
          "button": "REC",
          "op": "press"
        },
        {
          "ms": 1500,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "*REC* asks"
    },
    {
      "caption": "Key 2: voice 2's last note, the bass, from the last second of the tune, opens in LAB as LIFTED V2.",
      "control": "play F#3 for 0.3 s, then wait 1.5 s",
      "expect": [
        {
          "kind": "view",
          "value": "lab"
        },
        {
          "kind": "text",
          "value": "LIFTED V2"
        },
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "PRESS KEY 2",
        "control": "F#3"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "pick",
      "inputs": [
        {
          "ms": 300,
          "notes": [
            "F#3"
          ],
          "op": "note"
        },
        {
          "ms": 1500,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "A *key* answers"
    },
    {
      "caption": "The keys play the lifted sound over the tune.",
      "control": "play 8 notes at 120 BPM, then wait 0.6 s",
      "expect": [
        {
          "kind": "view",
          "value": "lab"
        },
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "PLAY THE KEYS",
        "control": "A3"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "keys",
      "inputs": [
        {
          "bpm": 120,
          "events": [
            {
              "notes": [
                "A3"
              ],
              "sixteenths": 2
            },
            {
              "notes": [
                "C4"
              ],
              "sixteenths": 2
            },
            {
              "notes": [
                "E4"
              ],
              "sixteenths": 2
            },
            {
              "notes": [
                "A4"
              ],
              "sixteenths": 2
            },
            {
              "notes": [
                "G4"
              ],
              "sixteenths": 2
            },
            {
              "notes": [
                "E4"
              ],
              "sixteenths": 2
            },
            {
              "notes": [
                "C4"
              ],
              "sixteenths": 2
            },
            {
              "notes": [
                "A3"
              ],
              "sixteenths": 4
            }
          ],
          "op": "play"
        },
        {
          "ms": 600,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "*Play* it"
    },
    {
      "caption": "SELECT to ENVELOPE, and K4 lengthens its release, as for any LAB sound.",
      "control": "turn SELECT clockwise by 1 detent, then wait 0.5 s, then turn K4 slowly clockwise by 3 detents over 0.6 s, then play 3 notes at 120 BPM, then wait 0.6 s",
      "expect": [
        {
          "kind": "text",
          "value": "ENVELOPE"
        },
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "SELECT, TURN K4",
        "control": "K4"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "shape",
      "inputs": [
        {
          "detents": 1,
          "encoder": "SELECT",
          "op": "turn"
        },
        {
          "ms": 500,
          "op": "wait"
        },
        {
          "detents": 3,
          "encoder": "K4",
          "ms": 600,
          "op": "sweep"
        },
        {
          "bpm": 120,
          "events": [
            {
              "notes": [
                "A3"
              ],
              "sixteenths": 2
            },
            {
              "notes": [
                "C4"
              ],
              "sixteenths": 2
            },
            {
              "notes": [
                "E4"
              ],
              "sixteenths": 4
            }
          ],
          "op": "play"
        },
        {
          "ms": 600,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "*Shape* it"
    },
    {
      "caption": "SAVE: a USER sound under its name, for PRESETS to find later.",
      "control": "press SAVE, then wait 2.5 s",
      "expect": [
        {
          "kind": "text",
          "value": "KEPT AS"
        }
      ],
      "focus": {
        "callout": "PRESS SAVE",
        "control": "SAVE"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "keep",
      "inputs": [
        {
          "button": "SAVE",
          "op": "press"
        },
        {
          "ms": 2500,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "*SAVE* keeps it"
    },
    {
      "caption": "HOME: NOW PLAYING, the tune still playing.",
      "control": "press HOME, then wait 1.2 s",
      "expect": [
        {
          "kind": "view",
          "value": "sid_view_playing"
        },
        {
          "kind": "text",
          "value": "PLAYING"
        },
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "PRESS HOME",
        "control": "HOME"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "back",
      "inputs": [
        {
          "button": "HOME",
          "op": "press"
        },
        {
          "ms": 1200,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "*HOME*: back to the tune"
    }
  ],
  "title": "Lift a sound from a .sid"
}
