      "id": "loaded",
      "inputs": [
        {
          "detents": 1,
          "encoder": "ALGORITHM",
          "op": "turn"
        },
        {
          "ms": 1500,
          "op": "wait"
        },
        {
          "detents": 1,
          "encoder": "SELECT",
          "op": "turn"
        },
        {
          "ms": 600,
          "op": "wait"
        },
        {
          "detents": 1,
          "encoder": "ALGORITHM",
          "op": "turn"
        },
        {
          "ms": 1500,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "And it is *back*"
    },
    {
      "caption": "SEQ and PLAY: BEAT 1, as you left it.",
      "control": "press SEQ, then wait 1.0 s, then press PLAY, then wait 4.0 s",
      "expect": [
        {
          "assert": "sounding",
          "kind": "audio"
        },
        {
          "kind": "view",
          "value": "step"
        }
      ],
      "focus": {
        "callout": "SEQ, PLAY",
        "screen": {
          "col": 0,
          "cols": 30,
          "row": 2,
          "rows": 13
