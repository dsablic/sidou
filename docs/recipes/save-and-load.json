      "inputs": [
        {
          "button": "SEQ",
          "op": "press"
        },
        {
          "ms": 1000,
          "op": "wait"
        },
        {
          "button": "PLAY",
          "op": "press"
        },
        {
          "ms": 4000,
          "op": "wait"
        }
