  ],
  "steps": [
    {
      "caption": "HOME, SETTINGS, BLUETOOTH: ALGORITHM turns it past ON to KEYBOARD, and SAVE opens DEVICES, the Bluetooth MIDI keyboards nearby with their signal bars.",
      "control": "press HOME, then wait 0.5 s, then turn SELECT until SETTINGS is selected, then press SAVE, then wait 0.5 s, then turn SELECT until BLUETOOTH is selected, then turn ALGORITHM clockwise by 2 detents, then wait 1.5 s, then press SAVE, then wait 2.0 s",
      "expect": [
        {
          "kind": "view",
          "value": "devices"
        },
        {
          "kind": "text",
          "value": "SCANNING"
        }
      ],
      "focus": {
        "callout": "SETTINGS > BLUETOOTH KEYBOARD, SAVE",
        "control": "SAVE"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "keyboard",
      "inputs": [
        {
          "button": "HOME",
          "op": "press"
        },
        {
          "ms": 500,
          "op": "wait"
        },
        {
          "op": "select_item",
          "text": "SETTINGS"
        },
        {
          "button": "SAVE",
          "op": "press"
        },
        {
          "ms": 500,
          "op": "wait"
        },
        {
          "op": "select_item",
          "text": "BLUETOOTH"
        },
        {
          "detents": 2,
          "encoder": "ALGORITHM",
          "op": "turn"
        },
        {
          "ms": 1500,
          "op": "wait"
        },
        {
          "button": "SAVE",
          "op": "press"
        },
        {
          "ms": 2000,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "A *Bluetooth keyboard*"
    },
    {
      "caption": "SAVE on a keyboard connects it: SIDOU pairs when it asks (a passkey shows large to type), keeps the bond, and connects again after a power cycle or when it comes back in range.",
      "control": "wait 5.6 s",
      "expect": [
        {
          "kind": "view",
          "value": "devices"
        }
      ],
      "focus": {
        "callout": "DEVICES > SAVE > KEYBOARD MICROKEY AIR",
        "control": "card"
