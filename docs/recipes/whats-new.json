{
  "goal": "See SIDOU 1.9's highlight: Bluetooth MIDI, turned on in SETTINGS, with a Mac, an iPad or a phone connecting to SIDOU.",
  "id": "whats-new",
  "prerequisites": {
    "start": "live",
    "text": "On LIVE after the boot, SIDOU LOOP the song loaded."
  },
  "related": [
    "mute-and-solo",
    "play-over-a-song",
    "chip-spread"
  ],
  "schema": "sidou-recipe/1",
  "skills": [
    "opening the song views",
    "PLAY",
    "SETTINGS",
    "BLUETOOTH",
    "Audio MIDI Setup's Bluetooth window"
  ],
  "steps": [
    {
      "caption": "SEQ twice opens the TRACKER, PLAY plays SIDOU LOOP. It plays on through what follows.",
      "control": "press SEQ, then wait 0.9 s, then press SEQ, then wait 0.9 s, then press PLAY, then wait 2.5 s",
      "expect": [
        {
          "kind": "view",
          "value": "tracker"
        },
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "SEQ TWICE, PLAY",
        "control": "PLAY"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "play",
      "inputs": [
        {
          "button": "SEQ",
          "op": "press"
        },
        {
          "ms": 900,
          "op": "wait"
        },
        {
          "button": "SEQ",
          "op": "press"
        },
        {
          "ms": 900,
          "op": "wait"
        },
        {
          "button": "PLAY",
          "op": "press"
        },
        {
          "ms": 2500,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "The song *plays*"
    },
    {
      "caption": "HOME twice, SETTINGS, the last item: BLUETOOTH. ALGORITHM turns it ON; it stays on after a power cycle.",
      "control": "press HOME, then wait 0.5 s, then press HOME, then wait 0.5 s, then turn SELECT until SETTINGS is selected, then press SAVE, then wait 0.5 s, then turn SELECT until BLUETOOTH is selected, then turn ALGORITHM clockwise by 1 detent, then wait 2.5 s",
      "expect": [
        {
          "kind": "view",
          "value": "settings"
        },
        {
          "kind": "text",
          "value": "BLUETOOTH"
        },
        {
          "kind": "text",
          "value": "ON"
        },
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "SETTINGS > BLUETOOTH ON",
        "control": "ALGORITHM"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "bluetooth",
      "inputs": [
        {
          "button": "HOME",
          "op": "press"
        },
        {
          "ms": 500,
          "op": "wait"
        },
        {
          "button": "HOME",
          "op": "press"
        },
        {
          "ms": 500,
          "op": "wait"
        },
        {
          "op": "select_item",
          "text": "SETTINGS"
        },
        {
          "button": "SAVE",
          "op": "press"
        },
        {
          "ms": 500,
          "op": "wait"
        },
        {
          "op": "select_item",
          "text": "BLUETOOTH"
        },
        {
          "detents": 1,
          "encoder": "ALGORITHM",
          "op": "turn"
        },
        {
          "ms": 2500,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "*BLUETOOTH* in SETTINGS"
    },
    {
      "caption": "On a Mac: Audio MIDI Setup, Window, Show MIDI Studio, the Bluetooth button, SIDOU XXXX, Connect. On an iPad or a phone, a music app's Bluetooth MIDI list.",
      "control": "wait 5.6 s",
      "expect": [
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "MAC OR IPAD <> BLUETOOTH <> SIDOU XXXX",
        "control": "card"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "connect",
      "inputs": [
        {
          "ms": 5600,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "*Connect*, no pairing"
    },
    {
      "caption": "Notes, CCs and a DAW's clock come in, the panel's knobs go out, as over USB. A dropped link lets go of held notes.",
      "control": "wait 5.0 s",
      "expect": [
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "NOTES, CCS, CLOCK <> SIDOU",
        "control": "card"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "play-it",
      "inputs": [
        {
          "ms": 5000,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "Play it from the *air*"
    },
    {
      "caption": "In your browser: dsablic.github.io/sidou. On your FM-1: github.com/dsablic/sidou/releases/latest",
      "control": "wait 3.2 s",
      "expect": [
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "control": "card"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "get-it",
      "inputs": [
        {
          "ms": 3200,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "Get *SIDOU 1.9*"
    }
  ],
  "title": "What's new in SIDOU 1.9"
}
