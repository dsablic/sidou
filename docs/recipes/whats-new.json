{
  "goal": "See SIDOU 1.6's highlights, one at a time: three oscillators layered on one key in LAB, a filter envelope of its own, the layered sound sent to the song and pulled back whole, and SidStation and MIDIbox SID banks imported as songs.",
  "id": "whats-new",
  "prerequisites": {
    "start": "live",
    "text": "On LIVE after the boot, SIDOU LOOP the song loaded: its lowest free instrument is 06."
  },
  "related": [
    "shape-in-lab",
    "send-to-song",
    "lift-a-sound"
  ],
  "schema": "sidou-recipe/1",
  "skills": [
    "LAB's LAYERS page",
    "ALGORITHM sets the oscillators",
    "K1 picks the layer OSC and ENVELOPE edit",
    "TRANS and DETUNE",
    "FILTER ENV",
    "REC in LAB sends to the song",
    "ENV on INSTR pulls into LAB",
    "sidou-sysex import"
  ],
  "steps": [
    {
