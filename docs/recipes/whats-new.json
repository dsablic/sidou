      "inputs": [
        {
          "detents": 1,
          "encoder": "K3",
          "op": "turn"
        },
        {
          "ms": 600,
          "op": "wait"
        },
        {
          "detents": 1,
          "encoder": "K4",
          "op": "turn"
        },
        {
          "ms": 800,
          "op": "wait"
        },
        {
          "detents": 1,
          "encoder": "K4",
          "op": "turn"
        },
        {
          "ms": 800,
          "op": "wait"
        },
        {
          "detents": 1,
          "encoder": "K4",
          "op": "turn"
        },
        {
          "ms": 800,
          "op": "wait"
        },
        {
          "detents": 1,
          "encoder": "K4",
          "op": "turn"
        },
        {
          "ms": 800,
          "op": "wait"
        },
        {
          "detents": 1,
          "encoder": "K4",
          "op": "turn"
        },
        {
          "ms": 1200,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "K3 picks a *voice*, K4 its *waveform*"
    },
    {
      "caption": "HOME: the tune is its own again at once.",
      "control": "press HOME, then wait 2.5 s",
      "expect": [
        {
          "assert": "sounding",
          "kind": "audio"
        },
        {
          "kind": "text",
          "value": "THE CONSULTANT"
        }
      ],
      "focus": {
        "callout": "PRESS HOME",
        "control": "HOME"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
