{
  "goal": "See SIDOU 1.10's highlight: a whole song written as text, loaded and played on the FM-1, and the USER sounds read back as patches on the Library page.",
  "id": "whats-new",
  "prerequisites": {
    "songs": [
      "three-parts"
    ],
    "start": "live",
    "text": "On LIVE after the boot; THREE PARTS, a song written as text (sidou-song/1), in the store."
  },
  "related": [
    "mute-and-solo",
    "play-over-a-song",
    "save-and-load",
    "shape-in-lab"
  ],
  "schema": "sidou-recipe/1",
  "skills": [
    "SONG LOAD",
    "SEQ opens the song views",
    "PLAY",
    "sidou-song/1",
    "the Library page",
    "USER sounds read over USB"
  ],
  "steps": [
    {
      "caption": "HOME, SONG, LOAD: THREE PARTS, written as text, is in the store like any other song.",
      "control": "press HOME, then wait 0.5 s, then turn SELECT until SONG is selected, then press SAVE, then wait 0.7 s, then press SAVE, then wait 1.5 s, then turn SELECT clockwise by 1 detent, then wait 0.5 s, then press SAVE, then wait 2.5 s",
      "expect": [
        {
          "kind": "view",
          "value": "song_menu"
        },
        {
          "kind": "text_absent",
          "value": "BUSY"
        },
        {
          "kind": "text_absent",
          "value": "SNG:"
        }
      ],
      "focus": {
        "callout": "HOME, SONG, SAVE, SAVE",
        "control": "SAVE"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "load",
      "inputs": [
        {
          "button": "HOME",
          "op": "press"
        },
        {
          "ms": 500,
          "op": "wait"
        },
        {
          "op": "select_item",
          "text": "SONG"
        },
        {
          "button": "SAVE",
          "op": "press"
        },
        {
          "ms": 700,
          "op": "wait"
        },
        {
          "button": "SAVE",
          "op": "press"
        },
        {
          "ms": 1500,
          "op": "wait"
        },
        {
          "detents": 1,
          "encoder": "SELECT",
          "op": "turn"
        },
        {
          "ms": 500,
          "op": "wait"
        },
        {
          "button": "SAVE",
          "op": "press"
        },
        {
          "ms": 2500,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "A song from *text*"
    },
    {
      "caption": "SEQ twice opens the TRACKER, PLAY plays the song: bass, drums and a lead, three sections in order.",
      "control": "press SEQ, then wait 0.9 s, then press SEQ, then wait 0.9 s, then press PLAY, then wait 6.0 s",
      "expect": [
        {
          "kind": "view",
          "value": "tracker"
        },
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "SEQ TWICE, PLAY",
        "control": "PLAY"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "play",
      "inputs": [
        {
          "button": "SEQ",
          "op": "press"
        },
        {
          "ms": 900,
          "op": "wait"
        },
        {
          "button": "SEQ",
          "op": "press"
        },
        {
          "ms": 900,
          "op": "wait"
        },
        {
          "button": "PLAY",
          "op": "press"
        },
        {
          "ms": 6000,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "It *plays*"
    },
    {
      "caption": "A model or coding agent writes the song as step-grid strings, sidou-song/1. The Library page previews it, sends it to the FM-1 or opens it in the editor; sidou-sysex song makes the file.",
      "control": "wait 5.6 s",
      "expect": [
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "A MODEL WRITES sidou-song/1 <> LIBRARY: PREVIEW, SEND, EDIT",
        "control": "card"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "text",
      "inputs": [
        {
          "ms": 5600,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "Written as *text*"
    },
    {
      "caption": "The Library page's USER sounds button reads the sounds LAB kept, over USB, and opens each as a patch. sidou-sysex user-sounds saves them as JSON. Read only.",
      "control": "wait 5.0 s",
      "expect": [
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "FM-1 > USER SOUNDS > LIBRARY AS PATCHES",
