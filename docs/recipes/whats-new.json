        {
          "op": "select_item",
          "text": "SONG"
        },
        {
          "detents": 1,
          "encoder": "ALGORITHM",
          "op": "turn"
        },
        {
          "ms": 300,
          "op": "wait"
        },
        {
          "detents": 1,
          "encoder": "SELECT",
          "op": "turn"
        },
        {
          "ms": 300,
          "op": "wait"
        },
        {
          "detents": 1,
          "encoder": "ALGORITHM",
          "op": "turn"
        },
        {
          "ms": 900,
