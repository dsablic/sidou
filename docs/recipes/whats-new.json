        {
          "kind": "view",
          "value": "tracker"
        },
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "MIDI CLOCK IN",
        "control": "screen",
        "screen": {
          "col": 0,
          "cols": 30,
          "row": 0,
          "rows": 3
