{
  "goal": "See SIDOU 1.5's highlights, one at a time: a sound lifted from a .sid into LAB, INSTR's pointer summaries and page jumps, LAB's song bridge, chords and time-shared drums from DICE, and the site's new tools.",
  "id": "whats-new",
  "prerequisites": {
    "start": "live",
    "text": "On LIVE after the boot, SIDOU LOOP the song loaded; THE CONSULTANT, a GoatTracker tune, in the store.",
    "tunes": [
      "consultant"
    ]
  },
  "related": [
    "lift-a-sound",
    "send-to-song",
    "shape-in-lab",
    "play-a-sid",
    "step-generative"
  ],
  "schema": "sidou-recipe/1",
  "skills": [
    "lifting a sound from a .sid into LAB",
    "SAVE keeps a USER sound",
    "INSTR's pointer summaries",
    "EDIT + SELECT pages",
    "ENV on INSTR pulls into LAB",
    "REC in LAB sends to the song",
    "a lane's role",
    "DICE's chords",
    "BASS+DRUMS"
  ],
  "steps": [
    {
      "caption": "The menu's SIDS: THE CONSULTANT, by Cadaver. ALGORITHM plays it.",
      "control": "press HOME, then wait 0.5 s, then turn SELECT until SIDS is selected, then press SAVE, then wait 1.2 s, then turn ALGORITHM clockwise by 1 detent, then wait 2.2 s",
      "expect": [
        {
          "kind": "view",
          "value": "sid_view_playing"
        },
        {
          "kind": "text",
          "value": "PLAYING"
        },
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "MENU > SIDS, ALGORITHM",
        "control": "ALGORITHM"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "lift-play",
      "inputs": [
        {
          "button": "HOME",
          "op": "press"
        },
        {
          "ms": 500,
          "op": "wait"
        },
        {
          "op": "select_item",
          "text": "SIDS"
        },
        {
          "button": "SAVE",
          "op": "press"
        },
        {
          "ms": 1200,
          "op": "wait"
        },
        {
          "detents": 1,
          "encoder": "ALGORITHM",
          "op": "turn"
        },
        {
          "ms": 2200,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "A *.sid* tune"
    },
    {
      "caption": "REC asks which voice; key 2 answers, and voice 2's last note, the bass, opens in LAB as LIFTED V2.",
      "control": "press REC, then wait 1.2 s, then play F#3 for 0.3 s, then wait 1.5 s",
      "expect": [
        {
          "kind": "view",
          "value": "lab"
        },
        {
          "kind": "text",
          "value": "LIFTED V2"
        },
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "PRESS REC, THEN KEY 2",
        "control": "REC"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
