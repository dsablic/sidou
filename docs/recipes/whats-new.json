      "control": "turn PRESETS clockwise by 5 detents, then wait 0.8 s, then hold EDIT and press SCL, then wait 0.6 s, then hold EDIT and press SCL, then wait 0.6 s, then hold EDIT and press SCL, then wait 1.5 s",
      "expect": [],
      "focus": {
        "callout": "PRESETS 303 BASS, DICE",
