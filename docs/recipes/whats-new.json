{
  "goal": "See SIDOU 1.20's highlights: a Bluetooth keyboard picked on DEVICES, SCENE opening on DEMO, SCOPE's traces, RED MOON RITE's art from the store fighting to the keys, LAB's glowing card and the mod wheel's vibrato.",
  "id": "whats-new",
  "prerequisites": {
    "art": [
      "red-moon-rite"
    ],
    "start": "live",
    "text": "On LIVE after the boot; RED MOON RITE's art pack in the store, as the Library page sends it."
  },
  "related": [
    "sidou-intro",
    "shape-in-lab",
    "chord-arpeggio"
  ],
  "schema": "sidou-recipe/1",
  "skills": [
    "SETTINGS",
    "BLUETOOTH KEYBOARD",
    "DEVICES",
    "SCENE",
    "DEMO",
    "SCOPE",
    "RED MOON RITE",
    "art packs",
