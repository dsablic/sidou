    {
      "caption": "In your browser: dsablic.github.io/sidou. On your FM-1: github.com/dsablic/sidou/releases/latest",
      "control": "wait 3.2 s",
      "expect": [
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "control": "card"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
