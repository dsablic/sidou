          "kind": "view",
          "value": "lab"
        },
        {
          "kind": "text",
          "value": "LAYERS"
        },
        {
          "kind": "text",
          "value": "8/8"
        },
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "ENV, TURN SELECT",
        "control": "SELECT"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
