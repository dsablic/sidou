    "shape-in-lab",
    "step-generative",
    "sidou-intro"
  ],
  "schema": "sidou-recipe/1",
  "skills": [
    "LAB's filter LFO",
    "the RESO link",
    "EDIT + key peeks at A",
    "DICE's range and rhythm",
    "MUTATE and DICE in TRACKER",
    "the filter sweep",
    "the ARP helper's audition",
    "a held step's locks"
