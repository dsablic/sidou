{
  "goal": "See SIDOU 1.8's highlights: live tweaks on a playing .sid, an ACID lane with slides and accents, a sound from a prompt, and sidou-sysex for coding agents.",
  "id": "whats-new",
  "prerequisites": {
    "start": "live",
    "text": "On LIVE after the boot, SIDOU LOOP the song loaded; THE CONSULTANT in the store.",
    "tunes": [
      "consultant"
    ]
  },
  "related": [
    "sid-tune-show",
    "step-a-beat",
    "send-to-song"
  ],
  "schema": "sidou-recipe/1",
  "skills": [
    "NOW PLAYING",
    "K1 bends a tune's cutoff",
    "K3 picks a voice",
    "K4 changes a voice's waveform",
    "HOME gives the tune back",
    "STEP",
    "the ACID lane role",
    "DICE",
    "PLAY",
    "the site's Library page",
    "llms.txt",
    "sidou-sysex"
  ],
  "steps": [
    {
      "caption": "In the menu, SIDS: the .sid tunes on the store. SAVE plays THE CONSULTANT.",
      "control": "press HOME, then wait 0.5 s, then turn SELECT until SIDS is selected, then press SAVE, then wait 2.8 s",
      "expect": [
        {
          "kind": "view",
          "value": "sid_now_playing"
        },
        {
          "kind": "text",
          "value": "THE CONSULTANT"
        },
        {
          "assert": "sounding",
          "kind": "audio"
        }
      ],
      "focus": {
        "callout": "SIDS, SAVE",
        "control": "screen"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "sids",
      "inputs": [
        {
          "button": "HOME",
          "op": "press"
        },
        {
          "ms": 500,
          "op": "wait"
        },
        {
          "op": "select_item",
          "text": "SIDS"
        },
        {
          "button": "SAVE",
          "op": "press"
        },
        {
          "ms": 2800,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "SIDS, *THE CONSULTANT*"
    },
    {
      "caption": "Turn K1 up and down: the tune's filter opens and closes, each detent. Back at 0 it is the tune's own.",
      "control": "turn K1 slowly clockwise by 40 detents over 1.0 s, then wait 0.5 s, then turn K1 slowly counter-clockwise by 40 detents over 1.0 s, then wait 1.5 s",
      "expect": [
        {
          "assert": "sounding",
          "kind": "audio"
        },
        {
          "kind": "text",
          "value": "CUT"
        }
      ],
      "focus": {
        "callout": "TURN K1",
        "control": "K1"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
      "id": "tweak-cut",
      "inputs": [
        {
          "detents": 40,
          "encoder": "K1",
          "ms": 1000,
          "op": "sweep"
        },
        {
          "ms": 500,
          "op": "wait"
        },
        {
          "detents": -40,
          "encoder": "K1",
          "ms": 1000,
          "op": "sweep"
        },
        {
          "ms": 1500,
          "op": "wait"
        }
      ],
      "needs": [],
      "title": "*K1* bends the *cutoff*"
    },
    {
      "caption": "K3 to voice 2; K4 through TRI, SAW, PUL, NOI, back to TUNE'S: the voice keeps its notes in each waveform.",
      "control": "turn K3 clockwise by 1 detent, then wait 0.6 s, then turn K4 clockwise by 1 detent, then wait 0.8 s, then turn K4 clockwise by 1 detent, then wait 0.8 s, then turn K4 clockwise by 1 detent, then wait 0.8 s, then turn K4 clockwise by 1 detent, then wait 0.8 s, then turn K4 clockwise by 1 detent, then wait 1.2 s",
      "expect": [
        {
          "assert": "sounding",
          "kind": "audio"
        },
        {
          "kind": "text",
          "value": "V2"
        },
        {
          "kind": "text",
          "value": "TUNE.S"
        }
      ],
      "focus": {
        "callout": "K3, K4",
        "control": "K3"
      },
      "harness": {
        "clip_ms": null,
        "defaults": false,
        "destructive": false,
        "milestone": null,
        "probe": false,
        "remember": false,
        "task": null
      },
