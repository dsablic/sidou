{
  "goal": "See SIDOU 2.0's highlights: PUNCH's held pads over SIDOU LOOP, chip B on the FM-1's second core on STATUS's CORES page, a layer's level in LAB, MULTI's parts and WHOLE A's chords played over MIDI, and a .sid tune's sounds on the Library page.",
  "id": "whats-new",
  "prerequisites": {
    "start": "live",
    "text": "On LIVE after the boot. SIDOU LOOP is the song loaded."
  },
  "related": [
    "play-over-a-song",
    "shape-in-lab",
    "mute-and-solo"
  ],
  "schema": "sidou-recipe/1",
  "skills": [
    "PUNCH",
    "STATUS's CORES page",
    "LAB's LAYERS level",
    "the MIDI page's MULTI and WHOLE A",
    "the Library page's .sid sounds"
  ],
