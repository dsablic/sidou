{
  "goal": "Make the synth sound the moment it is switched on.",
  "id": "first-sound",
  "prerequisites": {
    "start": "power-on",
    "text": "The FM-1 running SIDOU, just switched on; nothing else plugged in but headphones or speakers."
  },
  "related": [
    "shape-a-sound",
    "mute-and-solo"
  ],
  "schema": "sidou-recipe/1",
