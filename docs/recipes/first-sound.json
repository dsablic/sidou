        {
          "assert": "sounding",
          "kind": "audio"
        },
        {
          "kind": "audio_level",
          "max_dbfs": -8.0,
          "min_dbfs": -45.0
        }
      ],
      "focus": {
        "callout": "PRESS A KEY",
        "control": "A4"
