{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "fm1",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/pi32v2.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "fm1", "configurePreset": "fm1" }
  ]
}
