# Compiles every C file the host tests build (the SOURCES of host/crates/sidou-sys/build.rs,
# the gt2-ref shim and the sidou-pack harnesses) with GCC 13 in the build image, with the same
# flags as the cc crate's release build and warnings as errors. macOS's clang hides some errors
# that GCC reports; this is what CI's old `gcc` job caught, in seconds. Run it from the
# repository root or anywhere; it starts Docker through tools/fm1-docker.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
if [ -z "${SIDOU_BUILD_IMAGE:-}" ]; then exec "$root/tools/fm1-docker" sh "$root/tools/gcc-check" "$@"; fi
cd "$root"
gcc --version | head -n 1
case $(gcc -dumpversion) in 13*) ;; *) echo "gcc-check: GCC 13 expected" >&2; exit 1 ;; esac
out=$(mktemp -d); trap 'rm -rf "$out"' EXIT
jobs=$(nproc)

# The SOURCES slice of sidou-sys, in build.rs order.
sed -n '/^const SOURCES/,/^];/p' host/crates/sidou-sys/build.rs | sed -n 's/^ *"\(.*\)",$/\1/p' > "$out/list"
n=$(wc -l < "$out/list")
[ "$n" -gt 50 ] || { echo "gcc-check: found only $n sources in sidou-sys/build.rs" >&2; exit 1; }

# The firmware's own C, as the host tests build it.
cflags="-O3 -std=c11 -ffp-contract=off -Wall -Wextra -Wshadow -Werror -fPIC -ffunction-sections -fdata-sections"
cflags="$cflags -DSIDOU_ALL_COMBINED_PROFILES -DSIDOU_ALL_COMBINED_PROFILES_8580 -DSIDOU_MIDI_MAP_DOC -DSIDOU_REG_RING_RACE_HOOK"
cflags="$cflags -Icore -Ibench -Iapp -Ihost/crates/sidou-sys -DCPU6502_SMALL"
# shellcheck disable=SC2086
xargs -P "$jobs" -I{} sh -c 'gcc '"$cflags"' -c "$1" -o /dev/null || { echo "gcc-check: $1 failed" >&2; exit 255; }' _ {} < "$out/list"
# The 6502's test-only builds (sidou-sys's build.rs): CPU6502_HOOK_ALL, with and without the
# I/O accesses out of line.
for small in -DCPU6502_SMALL -UCPU6502_SMALL; do
    # shellcheck disable=SC2086
    gcc $cflags $small -DCPU6502_HOOK_ALL -c core/cpu6502/cpu6502.c -o /dev/null
done

# bindgen's wrappers for the static inline functions are compiled in the host build; the
# header-only ones are compiled here as part of the files that include them.

# The song player reference's shim (GoatTracker's own files are compiled without warnings).
gt=third_party/goattracker2/src; shim=host/crates/gt2-ref/shim
for f in gt2ref_shim.c gt2ref_asm.c gt2ref.c; do
    gcc -O3 -std=gnu11 -Wall -Wextra -Wno-unused-parameter -Wno-sign-compare -Werror \
        -I$shim -I$gt -DGT2REF_SRC_DIR='"x"' -c "$shim/$f" -o /dev/null
done

# The packager's harnesses: warnings on, as in their build.rs.
for f in ota_harness flash_hooks flash_spike_guard; do
    gcc -std=c11 -Wall -Wextra -Wno-unused-function -Iplatform/fm1/src -Iplatform/fm1 \
        -c "host/crates/sidou-pack/harness/$f.c" -o /dev/null
done
echo "gcc-check: $n firmware sources, the gt2-ref shim and the harnesses compiled by GCC 13"
