# Run a command in the pinned pi32v2 build image, e.g.  tools/fm1-docker cmake --preset fm1
# The repo is mounted at the same path, so CMake caches and paths stay valid outside.
#
# The image is ghcr.io/dsablic/sidou-build (tools/docker/Dockerfile, published by
# .github/workflows/build-image.yml). With tools/docker/image.digest (a line sha256:...) the
# command runs in exactly that image; without it, in :latest. Pulled once, when not here yet.
# When it cannot be pulled (offline, not published yet), or SIDOU_BUILD_LOCAL=1, the Dockerfile
# is built here instead. Inside the image itself (CI) the command just runs.
set -eu
if [ -n "${SIDOU_BUILD_IMAGE:-}" ]; then exec "$@"; fi
root=$(cd "$(dirname "$0")/.." && pwd)
repo=ghcr.io/dsablic/sidou-build
digest=$(sed -n 's/^\(sha256:[0-9a-f]\{64\}\).*/\1/p' "$root/tools/docker/image.digest" 2>/dev/null | head -n 1)
if [ -n "$digest" ]; then ref="$repo@$digest"; else ref="$repo:latest"; fi
image=
if [ -z "${SIDOU_BUILD_LOCAL:-}" ]; then
    if docker image inspect "$ref" >/dev/null 2>&1 \
        || docker pull --quiet --platform linux/amd64 "$ref" >/dev/null 2>&1; then
        image=$ref
    fi
fi
if [ -z "$image" ]; then
    image=sidou-build:local
    docker build --quiet --platform linux/amd64 -t "$image" \
        --build-arg TOOLCHAIN_SHA256="$(cat "$root/tools/docker/toolchain.sha256")" \
        "$root/tools/docker" >/dev/null
fi
exec docker run --rm --platform linux/amd64 -u "$(id -u):$(id -g)" \
    -v "$root:$root" -w "$root" "$image" "$@"
