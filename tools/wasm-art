set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
out="${1:-$root/build/wasm-art/sidou-art.wasm}"
obj="$root/build/wasm-art/obj"
mkdir -p "$obj" "$(dirname "$out")"

cc="${SIDOU_WASM_CC:-clang}"
ld="${SIDOU_WASM_LD:-}"
if [ -z "$ld" ]; then
    if [ -z "${SIDOU_WASM_RUST_LLD:-}" ] && command -v wasm-ld >/dev/null; then
        ld=wasm-ld
    else
        sysroot=$(rustc --print sysroot)
        host=$(rustc -vV | sed -n 's/^host: //p')
        export LD_LIBRARY_PATH="$sysroot/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        export DYLD_LIBRARY_PATH="$sysroot/lib${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
        ld="$sysroot/lib/rustlib/$host/bin/rust-lld -flavor wasm"
    fi
fi

sources=(
    platform/web/art_api.c
    app/art_pack.c app/scene_art.c app/scene_px.c app/scene_rmr.c app/scene_rmr_motion.c
    app/sine.c app/font.c app/grid.c app/store.c core/song/song_ext.c
    platform/fm1/libc_min.c
)
flags=(--target=wasm32-unknown-unknown -std=c11 -Os -nostdlib -fno-builtin -mbulk-memory
       -ffunction-sections -fdata-sections -Wall -Wextra -Werror -Wno-unused-parameter
       -isystem "$root/platform/web/include" -I"$root/core" -I"$root/app" -I"$root/platform/web")
objs=()
for s in "${sources[@]}"; do
    o="$obj/$(echo "$s" | tr / _).o"
    "$cc" "${flags[@]}" -c "$root/$s" -o "$o"
    objs+=("$o")
done
$ld --no-entry --gc-sections --strip-all -z stack-size=65536 --initial-memory=1048576 \
    "${objs[@]}" -o "$out"
echo "wasm-art: $out ($(wc -c <"$out" | tr -d ' ') bytes)"
