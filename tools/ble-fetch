set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
dest=${1:-$root/build/ext/fm1-base}
base_url=https://github.com/charlesvestal/fm1-base
base_rev=2d8ed74
bsp_url=https://github.com/hugelton/felucca-bsp
bsp_rev=773b0b9
if [ ! -d "$dest/.git" ]; then
    git clone --quiet "$base_url" "$dest"
fi
git -C "$dest" checkout --quiet "$base_rev"
if [ ! -d "$dest/bsp/.git" ] && [ ! -f "$dest/bsp/.git" ]; then
    rm -rf "$dest/bsp"
    git clone --quiet "$bsp_url" "$dest/bsp"
fi
git -C "$dest/bsp" checkout --quiet "$bsp_rev"
echo "fm1-base $(git -C "$dest" rev-parse --short HEAD), felucca-bsp $(git -C "$dest/bsp" rev-parse --short HEAD) in $dest"
