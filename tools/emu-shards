import json
import sys

USAGE = """The emulator gate split into CI's shards (TESTING.md, "What runs when").
  tools/emu-shards --matrix   the shard names, as JSON, for check.yml's matrix
  tools/emu-shards SHARD      that shard's cargo-nextest filter arguments, one a line
The long tests have shards of their own (a group's tests run side by side, one core each, so a
group holds a few single-threaded tests or those that spread over every core); every other
emulator test goes into the REST shards by slice (every Nth test of the whole list).
"""

GROUPS = [
    ["the_players_worst_block_fits_its_budget"],
    ["the_tracker_stays_within_its_budgets_while_a_song_plays"],
    ["red_moon_rite_stays_within_its_budgets_over_a_minute_of_the_song"],
    [
        "the_boot_and_about_stay_within_their_budgets",
        "the_song_and_a_tune_switch_both_ways_twenty_times_with_the_keys_routed_and_the_song_back_byte_for_byte",
        "the_step_view_stays_within_its_budgets_while_a_song_plays",
    ],
    [
        "a_cut_after_any_operation_leaves_the_old_value_or_the_new",
        "character_ccs_reach_the_chip_and_match_the_host_sample_exact",
        "clock_outs_start_goes_out_during_a_sysex_reply",
        "the_mirror_follows_live_tracker_the_menu_and_scene",
        "midi_learn_over_scene_and_live_stays_within_the_budget_from_opening_to_closing",
        "a_note_on_reaches_the_buffer_within_a_block_and_a_poll_while_the_screen_redraws",
    ],
]
REST = 7


def tests(names):
    return " | ".join(f"test(={name})" for name in names)


def shards():
    return [f"group-{g}" for g in range(1, len(GROUPS) + 1)] + [f"rest-{r}" for r in range(1, REST + 1)]


def arguments(shard):
    kind, _, number = shard.partition("-")
    n = int(number) if number.isdigit() else 0
    if kind == "group" and 1 <= n <= len(GROUPS):
        return ["-E", f"package(emu-gate) & ({tests(GROUPS[n - 1])})"]
    if kind == "rest" and 1 <= n <= REST:
        grouped = tests(name for group in GROUPS for name in group)
        return ["-E", f"package(emu-gate) & not ({grouped})", "--partition", f"slice:{n}/{REST}"]
    sys.exit(f"emu-shards: no shard {shard}; the shards are {', '.join(shards())}")


if len(sys.argv) != 2 or sys.argv[1] in ("-h", "--help"):
    sys.stdout.write(USAGE)
    sys.exit(0 if len(sys.argv) == 2 else 2)
if sys.argv[1] == "--matrix":
    print(json.dumps(shards()))
else:
    print("\n".join(arguments(sys.argv[1])))
