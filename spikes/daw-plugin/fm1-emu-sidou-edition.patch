diff --git a/crates/fm1-plugin/src/sidou.rs b/crates/fm1-plugin/src/sidou.rs
new file mode 100644
index 0000000..a4de2ce
--- /dev/null
+++ b/crates/fm1-plugin/src/sidou.rs
@@ -0,0 +1,153 @@
+use serde::Deserialize;
+
+#[derive(Clone, Copy, Deserialize)]
+pub struct Field {
+    pub at: u32,
+    pub len: u32,
+}
+
+#[derive(Clone, Deserialize)]
+pub struct StateMap {
+    pub lab_page: Field,
+    pub fx_select: Field,
+    pub preset: Field,
+    pub name: Field,
+    pub cutoff: Field,
+    pub resonance: Field,
+    pub attack_decay: Field,
+    pub sustain_release: Field,
+}
+
+pub const STATE_ENV: &str = "SIDOU_STATE";
+
+impl StateMap {
+    pub fn from_env() -> Option<StateMap> {
+        let text = std::fs::read_to_string(std::env::var(STATE_ENV).ok()?).ok()?;
+        serde_json::from_str(&text).ok()
+    }
+
+    pub fn regions(&self) -> Vec<(u32, u32)> {
+        [self.lab_page, self.fx_select, self.preset, self.name, self.cutoff, self.resonance, self.attack_decay, self.sustain_release]
+            .iter()
+            .map(|f| (f.at, f.len))
+            .collect()
+    }
+}
+
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Panel {
+    pub lab_page: u8,
+    pub fx_select: u8,
+    pub preset: u8,
+    pub name: String,
+    pub cutoff: u16,
+    pub resonance: u8,
+    pub adsr: [u8; 4],
+}
+
+pub const LAB_PAGES: [&str; 8] = ["OSC", "ENVELOPE", "FILTER", "FILTER ENV", "MOD", "FX", "MACRO", "LAYERS"];
+
+impl Panel {
+    pub fn read(peek: &[Vec<u8>]) -> Option<Panel> {
+        let [page, fx, preset, name, cutoff, reso, ad, sr] = peek else { return None };
+        let byte = |v: &Vec<u8>| v.first().copied().unwrap_or(0);
+        Some(Panel {
+            lab_page: byte(page),
+            fx_select: byte(fx),
+            preset: byte(preset),
+            name: name.iter().take_while(|&&c| c != 0).map(|&c| char::from(c)).collect(),
+            cutoff: u16::from_le_bytes([cutoff[0], cutoff[1]]),
+            resonance: byte(reso),
+            adsr: [byte(ad) >> 4, byte(ad) & 15, byte(sr) >> 4, byte(sr) & 15],
+        })
+    }
+
+    pub fn lines(&self) -> Vec<String> {
+        let page = LAB_PAGES.get(self.lab_page as usize).copied().unwrap_or("?");
+        let [a, d, s, r] = self.adsr;
+        vec![
+            format!("SOUND  {} (preset {})", self.name, self.preset),
+            format!("LAB    {page}, FX slot {}", self.fx_select + 1),
+            format!("ADSR   {a} {d} {s} {r}"),
+            format!("CUTOFF {}  RESO {}", self.cutoff, self.resonance),
+        ]
+    }
+}
+
+#[derive(Clone, Copy)]
+pub enum Target {
+    Cc { cc: u8 },
+    Nrpn { number: u16, max: u16 },
+    None,
+}
+
+use Target::{Cc, None as Unmapped, Nrpn};
+
+const FX_SLOT_CCS: [[u8; 4]; 3] = [[103, 104, 105, 106], [108, 109, 110, 111], [113, 114, 115, 116]];
+
+const PAGE_TARGETS: [[Target; 4]; 8] = [
+    [Nrpn { number: 2, max: 4095 }, Nrpn { number: 5, max: 2048 }, Nrpn { number: 6, max: 255 }, Nrpn { number: 7, max: 100 }],
+    [Cc { cc: 73 }, Cc { cc: 75 }, Cc { cc: 79 }, Cc { cc: 72 }],
+    [Nrpn { number: 0, max: 2047 }, Cc { cc: 71 }, Cc { cc: 24 }, Cc { cc: 31 }],
+    [Unmapped, Unmapped, Unmapped, Unmapped],
+    [Cc { cc: 76 }, Cc { cc: 77 }, Cc { cc: 78 }, Cc { cc: 28 }],
+    [Unmapped, Unmapped, Unmapped, Unmapped],
+    [Nrpn { number: 10, max: 16 }, Nrpn { number: 11, max: 16 }, Unmapped, Unmapped],
+    [Unmapped, Unmapped, Unmapped, Unmapped],
+];
+
+const FX_PAGE: usize = 5;
+
+pub fn target(page: u8, fx_select: u8, knob: usize) -> Target {
+    if page as usize == FX_PAGE {
+        return FX_SLOT_CCS.get(fx_select as usize).map_or(Unmapped, |ccs| Cc { cc: ccs[knob] });
+    }
+    PAGE_TARGETS.get(page as usize).map_or(Unmapped, |t| t[knob])
+}
+
+pub fn messages(target: Target, value: f32, channel: u8) -> Vec<[u8; 3]> {
+    let status = 0xb0 | (channel & 15);
+    let v = value.clamp(0.0, 1.0);
+    match target {
+        Cc { cc } => vec![[status, cc, (v * 127.0).round() as u8]],
+        Nrpn { number, max } => {
+            let data = (v * f32::from(max)).round() as u16;
+            vec![
+                [status, 99, (number >> 7) as u8],
+                [status, 98, (number & 127) as u8],
+                [status, 6, (data >> 7) as u8],
+                [status, 38, (data & 127) as u8],
+            ]
+        }
+        Unmapped => Vec::new(),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn an_envelope_knob_sends_its_cc_scaled_to_seven_bits() {
+        assert_eq!(messages(target(1, 0, 0), 1.0, 0), vec![[0xb0, 73, 127]]);
+        assert_eq!(messages(target(1, 0, 3), 0.5, 2), vec![[0xb2, 72, 64]]);
+    }
+
+    #[test]
+    fn the_cutoff_goes_as_an_nrpn_with_all_eleven_bits() {
+        assert_eq!(messages(target(2, 0, 0), 1.0, 0), vec![[0xb0, 99, 0], [0xb0, 98, 0], [0xb0, 6, 15], [0xb0, 38, 127]]);
+    }
+
+    #[test]
+    fn the_fx_page_follows_the_selected_slot() {
+        assert_eq!(messages(target(5, 2, 1), 0.0, 0), vec![[0xb0, 114, 0]]);
+        assert!(messages(target(5, 7, 1), 0.0, 0).is_empty());
+    }
+
+    #[test]
+    fn the_panel_decodes_the_watched_bytes() {
+        let peek = vec![vec![1], vec![0], vec![3], b"BASS\0\0".to_vec(), vec![0xb0, 0x04], vec![6], vec![0x09], vec![0xa6]];
+        let p = Panel::read(&peek).unwrap();
+        assert_eq!((p.name.as_str(), p.cutoff, p.adsr), ("BASS", 1200, [0, 9, 10, 6]));
+    }
+}
